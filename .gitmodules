[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "clintrialx"]
	path = clintrialx
	url = https://github.com/ineelhere/clintrialx
[submodule "llmshieldr"]
	path = llmshieldr
	url = https://github.com/ineelhere/llmshieldr
[submodule "shiny.ollama"]
	path = shiny.ollama
	url = https://github.com/ineelhere/shiny.ollama
